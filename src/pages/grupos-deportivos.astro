---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import { business } from '../data/business';

// NOTA: business.pages no tiene clave "grupos-deportivos"; el modelo nuevo la divide
// en "grupos-escolares" y "equipos-deportivos". Esta página (transitoria) consume la
// entrada sucesora "grupos-escolares" hasta que se haga el rename de rutas.
const page = business.pages['grupos-escolares'];
---

<BaseLayout title={page.title} description={page.description}>
  <Nav />
  <main id="inicio">
    <Section>
      <Container>
        <Heading as="h1" size="h1">Grupos deportivos</Heading>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
