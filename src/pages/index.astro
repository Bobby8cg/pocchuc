---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Heading from '../components/Heading.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Card from '../components/Card.astro';
import { business } from '../data/business';

const { brand, pages, contact, stats, cases, process, aboutParagraphs, services } =
  business;
---

<BaseLayout
  title={pages.home.title}
  description={pages.home.description}
  schemaType="travelagency"
>
  <Nav />

  <main>
    <!-- 5.1 Hero -->
    <Section id="inicio" class="flex min-h-screen items-center">
      <Container>
        <div class="grid items-center gap-8 md:grid-cols-12">
          <!-- Símbolo placeholder (se sustituye por el logo real) -->
          <div class="flex justify-center md:col-span-5 md:justify-start">
            <div class="relative aspect-square w-[300px] max-w-full" aria-hidden="true">
              <div class="absolute inset-0 rounded-full bg-accent-primary"></div>
              <svg
                class="absolute inset-0 m-auto h-1/3 w-1/3 text-surface-base-dark"
                viewBox="0 0 100 100"
                fill="currentColor"
              >
                <polygon points="50,18 88,84 12,84"></polygon>
              </svg>
            </div>
          </div>

          <!-- Contenido -->
          <div class="md:col-span-7">
            <Heading as="h1" size="display-xl" class="font-bold leading-tight">
              <Fragment set:html={brand.tagline.replace('. ', '.<br />')} />
            </Heading>
            <p class="mt-6 text-body-lg text-ink-primary-dark/60">
              {brand.manifesto}
            </p>
            <div class="mt-9 flex flex-col gap-4 sm:flex-row">
              <Button variant="primary" href="/contacto">Cotiza tu viaje →</Button>
              <Button variant="ghost" href="#como-trabajamos">Ver cómo trabajamos ↓</Button>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <!-- 5.2 Cómo trabajamos -->
    <Section id="como-trabajamos">
      <Container>
        <div class="max-w-3xl">
          <Eyebrow>El proceso</Eyebrow>
          <Heading as="h2" size="display-md" class="mt-4">
            Un proceso probado. Cero improvisación.
          </Heading>
          <p class="mt-4 text-body-lg text-ink-primary-dark/70">
            Así es como armamos cada viaje — desde el primer mensaje hasta el regreso
            del grupo.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            process.map((p) => (
              <Card>
                <span class="block text-display-md text-accent-primary">{p.number}</span>
                <Heading as="h3" size="h3" class="mt-4">
                  {p.title}
                </Heading>
                <p class="mt-3 text-body-md text-ink-primary-dark/70">{p.body}</p>
              </Card>
            ))
          }
        </div>

        <div class="mt-9">
          <Button variant="ghost" href="/como-trabajamos">Ver el proceso completo →</Button>
        </div>
      </Container>
    </Section>

    <!-- 5.3 Stats bar -->
    <Section variant="elevated">
      <Container>
        <div class="grid gap-12 text-center md:grid-cols-3">
          {
            stats.map((s) => (
              <div>
                <span class="block text-display-lg text-accent-primary">{s.value}</span>
                <span class="mt-2 block text-body-md text-ink-primary-dark">{s.label}</span>
                <span class="mt-1 block text-body-sm text-ink-primary-dark/40">{s.sublabel}</span>
              </div>
            ))
          }
        </div>
        <p class="mt-12 text-center text-body-sm text-ink-primary-dark/40">
          Actualizado al noviembre 2026.
        </p>
      </Container>
    </Section>

    <!-- 5.4 About editorial -->
    <Section>
      <Container>
        <div class="grid gap-12 md:grid-cols-12">
          <div class="md:col-span-5">
            <Heading as="h2" size="display-md">
              No todos los viajes son vacaciones.
            </Heading>
          </div>
          <div class="space-y-6 md:col-span-7">
            {
              aboutParagraphs.map((paragraph) => (
                <p class="text-body-lg text-ink-primary-dark/70">{paragraph}</p>
              ))
            }
            <Button variant="ghost" href="/sobre">Conoce más sobre nosotros →</Button>
          </div>
        </div>
      </Container>
    </Section>

    <!-- 5.5 Servicios -->
    <Section>
      <Container>
        <div class="max-w-3xl">
          <Eyebrow>Servicios</Eyebrow>
          <Heading as="h2" size="display-md" class="mt-4">
            Tres productos. Un solo estándar.
          </Heading>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {
            services.map((s) => (
              <Card variant={s.featured ? 'highlighted' : 'default'} class="flex flex-col">
                <span
                  class:list={[
                    'block text-caption uppercase',
                    s.featured ? 'text-accent-primary' : 'text-ink-primary-dark/50',
                  ]}
                >
                  {s.eyebrow}
                </span>
                <Heading as="h3" size="h3" class="mt-4">
                  {s.title}
                </Heading>
                <p class="mt-3 text-body-md text-ink-primary-dark/70">{s.description}</p>
                <ul class="mt-6 space-y-2">
                  {s.bullets.map((bullet) => (
                    <li class="flex items-start gap-2 text-body-sm text-ink-primary-dark/80">
                      <span class="text-accent-primary" aria-hidden="true">
                        ✓
                      </span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-auto pt-8">
                  <Button variant="secondary" href={s.cta.href}>
                    {s.cta.label}
                  </Button>
                </div>
              </Card>
            ))
          }
        </div>
      </Container>
    </Section>

    <!-- 5.6 Casos destacados -->
    <Section variant="elevated">
      <Container>
        <div class="max-w-3xl">
          <Eyebrow>Casos</Eyebrow>
          <Heading as="h2" size="display-md" class="mt-4">Lo que hemos armado.</Heading>
          <p class="mt-4 text-body-lg text-ink-primary-dark/70">
            Tres casos reales. Cada uno tiene su propio hub digital.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {
            cases.map((c) => (
              <Card>
                <div
                  class="aspect-video w-full rounded-md bg-divider-dark"
                  role="img"
                  aria-label={c.imageAlt ?? `Imagen del caso ${c.title} (pendiente)`}
                />
                <Heading as="h3" size="h3" class="mt-6">
                  {c.title}
                </Heading>
                <p class="mt-3 text-body-md text-ink-primary-dark/70">{c.highlights}</p>
              </Card>
            ))
          }
        </div>

        <div class="mt-9">
          <Button variant="ghost" href="/casos">Ver todos los casos →</Button>
        </div>
      </Container>
    </Section>

    <!-- 5.7 CTA final -->
    <Section variant="inverse">
      <Container class="text-center">
        <div class="mx-auto max-w-3xl">
          <Heading as="h2" size="display-md">¿Tienes un viaje que armar?</Heading>
          <p class="mt-6 text-body-lg text-ink-primary-light/70">
            Cotización estándar en 48 h sin costo. ¿Necesitas antes? Express en 24 h por
            $500 MXN adicionales al total.
          </p>
          <div class="mt-9 flex flex-col justify-center gap-4 sm:flex-row">
            <Button variant="primary" href="/contacto">Cotiza tu viaje →</Button>
            <Button
              variant="ghost"
              href={contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              O escríbenos por WhatsApp →
            </Button>
          </div>
        </div>
      </Container>
    </Section>
  </main>

  <Footer />
</BaseLayout>
