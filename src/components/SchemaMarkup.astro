---
import { business } from '../data/business';

export interface Props {
  type?:
    | 'organization'
    | 'travelagency'
    | 'service'
    | 'faqpage'
    | 'person'
    | 'breadcrumb';
  data?: Record<string, unknown>;
}

const { type = 'organization', data } = Astro.props;

const { brand, credentials, contact } = business;

// Datos de organización compartidos entre Organization y TravelAgency
const orgCore = {
  name: brand.name,
  url: brand.url,
  logo: `${brand.url}/logo.png`,
  description: brand.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: credentials.city,
    addressRegion: credentials.region,
    addressCountry: credentials.country,
  },
  email: contact.email,
  founder: {
    '@type': 'Person',
    name: credentials.founderName,
  },
};

const defaults: Record<string, Record<string, unknown>> = {
  organization: {
    '@type': 'Organization',
    ...orgCore,
  },
  travelagency: {
    '@type': 'TravelAgency',
    ...orgCore,
    iataCode: credentials.iataNumber,
    // areaServed no está en business.ts (no es parte del modelo de datos central)
    areaServed: ['México', 'Estados Unidos', 'Canadá', 'Europa', 'Sureste Asiático'],
  },
  person: {
    '@type': 'Person',
    name: credentials.founderName,
    jobTitle: 'Fundador',
    worksFor: { '@type': 'Organization', name: brand.name },
    url: brand.url,
  },
  service: { '@type': 'Service' },
  faqpage: { '@type': 'FAQPage' },
  breadcrumb: { '@type': 'BreadcrumbList' },
};

const schema = {
  '@context': 'https://schema.org',
  ...(defaults[type] ?? defaults.organization),
  ...(data ?? {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
