---
import { business } from '../data/business';

// Primeros 3 links: derivados de business.services (label a partir del slug).
const toLabel = (slug: string) => {
  const words = slug.replace(/-/g, ' ');
  return words.charAt(0).toUpperCase() + words.slice(1);
};

const serviceLinks = business.services.map((s) => ({
  href: s.cta.href,
  label: toLabel(s.slug),
}));

// Links fijos.
const fixedLinks = [
  { href: '/como-trabajamos', label: 'Cómo trabajamos' },
  { href: '/casos', label: 'Casos' },
  { href: '/sobre', label: 'Sobre' },
];

const links = [...serviceLinks, ...fixedLinks];
---

<header class="sticky top-0 z-50 border-b border-divider-dark bg-surface-base-dark/90 backdrop-blur">
  <nav class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-4" aria-label="Principal">
    <!-- Logo placeholder (texto; se sustituye por el SVG real después) -->
    <a href="/" class="flex items-center gap-2 text-h4 font-bold tracking-tight text-ink-primary-dark">
      <span>{business.brand.name}</span>
    </a>

    <!-- Links desktop -->
    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-body-sm text-ink-primary-dark/80 transition-colors hover:text-accent-primary"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- CTA desktop -->
    <a
      href="/contacto"
      class="hidden rounded-md bg-accent-primary px-4 py-2.5 text-button text-surface-base-dark transition-colors hover:bg-accent-primary-hover md:inline-block"
    >
      Cotiza tu viaje →
    </a>

    <!-- Burger (mobile) -->
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-ink-primary-dark md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </nav>
</header>

<!-- Menú mobile: overlay full-screen.
     Va FUERA del <header> a propósito: el header tiene backdrop-blur
     (backdrop-filter), lo que lo convierte en bloque contenedor de los
     descendientes position:fixed y recortaría el overlay. -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden flex-col bg-surface-base-dark md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
  >
    <div class="flex items-center justify-between border-b border-divider-dark px-6 py-4">
      <span class="text-h4 font-bold tracking-tight text-ink-primary-dark">{business.brand.name}</span>
      <button
        id="nav-close"
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-ink-primary-dark"
        aria-label="Cerrar menú"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
    <nav class="flex flex-1 flex-col gap-1 overflow-y-auto px-6 py-6" aria-label="Navegación móvil">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="block rounded-md py-3 text-h4 text-ink-primary-dark/90 hover:text-accent-primary"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="mt-4 block rounded-md bg-accent-primary px-4 py-3 text-center text-button text-surface-base-dark hover:bg-accent-primary-hover"
      >
        Cotiza tu viaje →
      </a>
    </nav>
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('nav-close');

  if (toggle && menu) {
    const focusable = () =>
      Array.from(
        menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      );

    const openMenu = () => {
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú');
      document.body.style.overflow = 'hidden';
      (closeBtn ?? focusable()[0])?.focus();
    };

    const closeMenu = () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú');
      document.body.style.overflow = '';
      toggle.focus();
    };

    toggle.addEventListener('click', () =>
      menu.classList.contains('hidden') ? openMenu() : closeMenu(),
    );
    closeBtn?.addEventListener('click', closeMenu);

    // Cerrar el menú al clickear cualquier link.
    menu.querySelectorAll('a[href]').forEach((link) =>
      link.addEventListener('click', closeMenu),
    );

    // Escape cierra; Tab queda atrapado dentro del overlay (focus trap).
    document.addEventListener('keydown', (event) => {
      if (menu.classList.contains('hidden')) return;
      if (event.key === 'Escape') {
        closeMenu();
        return;
      }
      if (event.key === 'Tab') {
        const items = focusable();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
