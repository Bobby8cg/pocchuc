---
import { business } from '../data/business';

const links = [
  { href: '/grupos-deportivos', label: 'Grupos deportivos' },
  { href: '/ejecutivos', label: 'Ejecutivos' },
  { href: '/como-trabajamos', label: 'Cómo trabajamos' },
  { href: '/casos', label: 'Casos' },
  { href: '/sobre', label: 'Sobre' },
];
---

<header class="sticky top-0 z-50 border-b border-divider-dark bg-surface-base-dark/90 backdrop-blur">
  <nav class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-4" aria-label="Principal">
    <!-- Logo placeholder (texto; se sustituye por el SVG real después) -->
    <a href="/" class="flex items-center gap-2 text-h4 font-bold tracking-tight text-ink-primary-dark">
      <span>{business.brand.name}</span>
    </a>

    <!-- Links desktop -->
    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-body-sm text-ink-primary-dark/80 transition-colors hover:text-accent-primary"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- CTA desktop -->
    <a
      href="/contacto"
      class="hidden rounded-md bg-accent-primary px-4 py-2.5 text-button text-surface-base-dark transition-colors hover:bg-accent-primary-hover md:inline-block"
    >
      Cotiza tu viaje →
    </a>

    <!-- Burger (mobile) -->
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-ink-primary-dark md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </nav>

  <!-- Menú mobile -->
  <div id="mobile-menu" class="hidden border-t border-divider-dark px-6 pb-6 pt-2 md:hidden">
    <ul class="flex flex-col gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md py-2 text-body-md text-ink-primary-dark/90 hover:text-accent-primary"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href="/contacto"
          class="block rounded-md bg-accent-primary px-4 py-3 text-center text-button text-surface-base-dark hover:bg-accent-primary-hover"
        >
          Cotiza tu viaje →
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
  });
</script>
