---
import { business } from '../data/business';

const { brand, credentials, contact } = business;
---

<footer class="border-t border-divider-dark bg-surface-base-dark text-ink-primary-dark">
  <div class="mx-auto grid max-w-[1200px] gap-9 px-6 py-11 md:grid-cols-3">
    <!-- Columna 1: Marca -->
    <div class="flex flex-col gap-3">
      <span class="text-h4 font-bold tracking-tight">{brand.name}</span>
      <p class="text-body-sm font-medium text-accent-primary">{brand.tagline}</p>
      <p class="max-w-xs text-body-sm text-ink-primary-dark/70">
        {brand.description}
      </p>
    </div>

    <!-- Columna 2: Enlaces -->
    <div class="flex flex-col gap-3">
      <span class="text-overline uppercase text-ink-primary-dark/50">Navegación</span>
      <nav class="flex flex-col gap-2 text-body-sm" aria-label="Pie de página">
        <a href="/como-trabajamos" class="text-ink-primary-dark/80 hover:text-accent-primary">Servicios</a>
        <a href="/sobre" class="text-ink-primary-dark/80 hover:text-accent-primary">Nosotros</a>
        <a href="/contacto" class="text-ink-primary-dark/80 hover:text-accent-primary">Contacto</a>
      </nav>
    </div>

    <!-- Columna 3: Legal + credenciales -->
    <div class="flex flex-col gap-3">
      <span class="text-overline uppercase text-ink-primary-dark/50">Legal</span>
      <nav class="flex flex-col gap-2 text-body-sm" aria-label="Legal">
        <a href="/aviso-de-privacidad" class="text-ink-primary-dark/80 hover:text-accent-primary">Aviso de privacidad</a>
        <a href="/terminos" class="text-ink-primary-dark/80 hover:text-accent-primary">Términos</a>
      </nav>
      <p class="text-body-sm text-ink-primary-dark/60">
        Afiliados a {credentials.hostAgency} · Agentes certificados IATA #{credentials.iataNumber}
      </p>
      <a
        href={`mailto:${contact.email}`}
        class="text-body-sm text-ink-primary-dark/80 hover:text-accent-primary"
      >
        {contact.email}
      </a>
    </div>
  </div>

  <div class="border-t border-divider-dark">
    <div class="mx-auto max-w-[1200px] px-6 py-6">
      <p class="text-caption uppercase text-ink-primary-dark/50">
        © {credentials.foundedYear} {brand.name}
      </p>
    </div>
  </div>
</footer>
