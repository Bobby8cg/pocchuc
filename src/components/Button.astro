---
export interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  size?: 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  rel?: string;
  class?: string;
}
const {
  variant = 'primary',
  href,
  size = 'md',
  type = 'button',
  target,
  rel,
  class: className = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-semibold text-button rounded-md transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-base-dark';

const sizes: Record<string, string> = {
  md: 'px-5 py-3',
  lg: 'px-7 py-4 text-h4',
};

const variants: Record<string, string> = {
  primary: 'bg-accent-primary text-surface-base-dark hover:bg-accent-primary-hover',
  secondary:
    'border-2 border-ink-primary-dark/20 text-ink-primary-dark hover:border-ink-primary-dark/40',
  ghost: 'text-accent-primary hover:underline',
};

const classes = [base, sizes[size], variants[variant], className];
---

{
  href ? (
    <a href={href} target={target} rel={rel} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes}>
      <slot />
    </button>
  )
}
