---
import SEO from '../components/SEO.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  keywords?: string;
  schemaType?:
    | 'organization'
    | 'travelagency'
    | 'service'
    | 'faqpage'
    | 'person'
    | 'breadcrumb';
  schemaData?: Record<string, unknown>;
}

const {
  title,
  description,
  ogImage,
  canonical,
  keywords,
  schemaType = 'organization',
  schemaData,
} = Astro.props;
---

<!doctype html>
<html lang="es-MX" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A1F26" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon (placeholder hasta tener el favicon real del logo) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Fonts: Inter 300–700 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
    />

    <!-- SEO meta + structured data -->
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      canonical={canonical}
      keywords={keywords}
    />
    <SchemaMarkup type={schemaType} data={schemaData} />

    <!-- TODO GA4: insertar el script de Google Analytics cuando esté la cuenta.
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXX"></script>
    -->
  </head>
  <body>
    <!-- Skip link para accesibilidad -->
    <a
      href="#inicio"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent-primary focus:px-4 focus:py-2 focus:text-button focus:text-surface-base-dark"
    >
      Saltar al contenido
    </a>

    <slot />

    <style is:global>
      html {
        font-size: calc(16 * (100vw / 1440));
        background-color: #0a1f26;
        color: #faf8f5;
      }
      @media (max-width: 479px) {
        html {
          font-size: calc(16 * (100vw / 375));
        }
      }
      @media (min-width: 1440px) {
        html {
          font-size: 16px;
        }
      }
      @media (min-width: 1920px) {
        html {
          font-size: calc(16 * (100vw / 1920));
        }
      }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        margin: 0;
        min-height: 100vh;
      }
      /* Focus visible global (accent-primary) para accesibilidad */
      :where(a, button, input, textarea, select):focus-visible {
        outline: 2px solid #e8862b;
        outline-offset: 2px;
        border-radius: 2px;
      }
      html {
        scroll-behavior: smooth;
        /* Altura aproximada del nav sticky, usada como offset de scroll. */
        --nav-height: 5rem;
      }
      /* El nav sticky no debe tapar el heading de la sección destino. */
      :target,
      section[id] {
        scroll-margin-top: var(--nav-height);
      }
      /* Respeta la preferencia de movimiento reducido. */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
